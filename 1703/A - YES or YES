#include <iostream>
using namespace std;
int main(){
    int t;
    cin>>t;
    for(int i=0; i<t; i++){
        string s;
        cin>>s;
        for(int j=0; j<3; j++){
            if(s[j]>='a' && s[j]<='z'){
                s[j]-=32;
            }
        }
        if(s=="YES"){
            cout<<"YES"<<endl;
        }
        else{
            cout<<"NO"<<endl;
        }
    }
}