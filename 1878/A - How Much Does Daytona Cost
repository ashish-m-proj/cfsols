#include <iostream>
using namespace std;
int main(){
    int t;
    cin>>t;
    for(int j=0; j<t; j++){
        int n, k;
        cin>>n>>k;
        int a[n];
        bool check=false;
        for(int i=0; i<n; i++){
            cin>>a[i];
            }
        for(int i=0; i<n; i++){
                if(a[i]==k){
                cout<<"YES"<<endl;
                check=true;
                break;
        }
        }
        if(!check){
                cout<<"NO"<<endl;
        }
    }
}